<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- 沿用舊版主程式名稱，維持 Velopack 的 main-exe 與既有安裝的升級路徑。 -->
    <AssemblyName>CloudyWing.SchemaExporter</AssemblyName>
    <RootNamespace>CloudyWing.SchemaExporter.Desktop</RootNamespace>
    <ApplicationIcon>Assets\SchemaExporter.ico</ApplicationIcon>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchemaExporter.Core\SchemaExporter.Core.csproj" />
    <ProjectReference Include="..\SchemaExporter.Infrastructure\SchemaExporter.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SchemaExporter.ico" />
  </ItemGroup>

</Project>
