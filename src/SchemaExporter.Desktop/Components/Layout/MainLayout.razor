@inherits LayoutComponentBase
@implements IDisposable
@inject ExportWorkspace ExportWorkspace
@inject UpdateWorkspace UpdateWorkspace

<div class="shell">
    <nav class="sidebar" aria-label="主要功能">
        <div class="brand">
            <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                <ellipse cx="14" cy="7" rx="10" ry="4" fill="#cfe0f2" />
                <path d="M4 7v17c0 2.2 4.5 4 10 4s10-1.8 10-4V7c0 2.2-4.5 4-10 4S4 9.2 4 7z" fill="#f0f6fc" />
                <path d="M4 13.5c0 2.2 4.5 4 10 4s10-1.8 10-4M4 19c0 2.2 4.5 4 10 4s10-1.8 10-4" fill="none" stroke="#1c5ca0" stroke-width="1.6" />
                <path d="M21 30c1-6 4-10 10-12-1 6-4 10-10 12z" fill="#ffc43d" />
            </svg>
            <span class="brand-text">Schema Exporter</span>
        </div>
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">匯出</NavLink>
        @if (ExportWorkspace.IsExporting) {
            <span class="nav-item disabled" title="匯出進行中，完成後才能修改設定。">設定</span>
        } else {
            <NavLink class="nav-item" href="settings">設定</NavLink>
        }
        <div class="sidebar-footer">
            @if (!string.IsNullOrWhiteSpace(UpdateWorkspace.StatusMessage)) {
                <p class="update-status">@UpdateWorkspace.StatusMessage</p>
            }
        </div>
    </nav>
    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() {
        ExportWorkspace.Changed += HandleChanged;
        UpdateWorkspace.Changed += HandleChanged;
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            // 更新檢查在背景進行，不阻擋第一次畫面顯示。
            _ = UpdateWorkspace.CheckForUpdatesAsync();
        }
    }

    public void Dispose() {
        ExportWorkspace.Changed -= HandleChanged;
        UpdateWorkspace.Changed -= HandleChanged;
    }

    private void HandleChanged() {
        _ = InvokeAsync(StateHasChanged);
    }
}
