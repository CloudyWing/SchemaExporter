<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CloudyWing.SchemaExporter.Cli</AssemblyName>
    <RootNamespace>CloudyWing.SchemaExporter.Cli</RootNamespace>
    <ApplicationIcon>..\SchemaExporter.Desktop\Assets\SchemaExporter.ico</ApplicationIcon>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchemaExporter.Core\SchemaExporter.Core.csproj" />
    <ProjectReference Include="..\SchemaExporter.Infrastructure\SchemaExporter.Infrastructure.csproj" />
  </ItemGroup>

</Project>
